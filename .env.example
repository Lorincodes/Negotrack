# Public canonical origin used for metadata, sitemap, and social sharing URLs.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Analytics. All are public identifiers, not secrets, and all are optional:
# each provider loads only when its own variable is set AND the build is a
# production build, so development and the e2e suite never report real data.
# Google Analytics 4 — Admin > Data streams > your web stream ("G-XXXXXXXXXX").
# Leave empty if GA4 is configured as a tag inside Tag Manager below, or the
# same property receives every hit twice.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Tag Manager container ("GTM-XXXXXXX"). When set, the direct GA4 tag
# above stands down and GA4 is expected to be managed inside the container.
NEXT_PUBLIC_GTM_CONTAINER_ID=
# Microsoft Clarity — Settings > Overview > Project ID.
NEXT_PUBLIC_CLARITY_PROJECT_ID=
# Google Search Console — the token from the "HTML tag" verification method.
# Paste only the content value, not the whole <meta> tag.
NEXT_PUBLIC_GSC_VERIFICATION=

# Server-only Supabase credentials. Never prefix the service-role key with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional confirmation email. Both values are required to enable sending.
RESEND_API_KEY=re_your_api_key
WAITLIST_FROM_EMAIL="NegoTrack <updates@example.com>"

# Change this when the privacy notice changes materially.
WAITLIST_PRIVACY_NOTICE_VERSION=2026-08-04

# Only enable when a trusted reverse proxy overwrites these headers and direct
# access to the Node.js origin is blocked.
WAITLIST_TRUST_PROXY_HEADERS=false
